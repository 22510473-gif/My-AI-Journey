class Board:
    def __init__(self):
        self.board=[]
        for i in range(1,10):
            self.board.append(str(i))
            
            
    def disply(self):
        for i in range(0,9,3):
            print(f" {self.board[i]} | {self.board[i+1]} | {self.board[i+2]} ")
            if i < 6:
                print("_"*10)
                
    def updat(self,choice,symbol):
        if self.board[choice-1].isdigit():##هذه بتفحص الموقع انو رقم ولالا
            self.board[choice-1]=symbol
            return True
        print("المكان محجوز يا حب!")
        return False 
    
    def is_full(self):
        for v in self.board: 
            if v.isdigit():
                return False
        return True
    
    
    
    def check_winner(self,s):
        win = [
        (0, 1, 2), (3, 4, 5), (6, 7, 8), 
        (0, 3, 6), (1, 4, 7), (2, 5, 8), 
        (0, 4, 8), (2, 4, 6) ]
        for a, b, c in win:
            if self.board[a] == self.board[b] == self.board[c] == s:
                return True 
            
        return False 
        
class Game:
    def __init__(self):
        self.board=Board()
        self.plyer1=Plyere()
        self.plyer2=Plyere()
        self.curent_plyer=None
    
    def switch_player(self):
        if self.curent_plyer==self.plyer1:
            self.curent_plyer=self.plyer2
        else:
            self.curent_plyer=self.plyer1
    
    def play(self):
        print("<<-- عمليه تعيين اسماء ورموز اللاعبين للبدء -->>")
        self.plyer1.choos_name()
        self.plyer1.choos_symbol()
        self.plyer2.choos_name()
        self.plyer2.choos_symbol()
        self.curent_plyer=self.plyer1
        self.score1=0
        self.score2=0
        
        while True:
            self.board = Board() 
            self.curent_plyer = self.plyer1
            print("\n" + "="*20)
            print("النتيجة الحالية:")
            print(f"{self.plyer1.name}: {self.score1}")
            print(f"{self.plyer2.name}: {self.score2}")
            print("="*20)
            
            print("**بعد تجهيز المعلومات يلا اربطو الاحزمه ياشباب**")
            print("\n" + "-"*20)
            while True:
                    self.board.disply()
                    print("-"*20)
                    print(f"الدور الآن على: {self.curent_plyer.name} ({self.curent_plyer.symbol})")
                    
                    choice = int(input(f"يا {self.curent_plyer.name}، اختر مكانك (1-9): "))
                    
                    
                    if self.board.updat(choice, self.curent_plyer.symbol):
                        
                       
                        if self.board.check_winner(self.curent_plyer.symbol):
                            self.board.disply()
                            print("سبع مش بايدك .على كل حال مبروك ياوحش ")
                            if self.curent_plyer == self.plyer1:
                                self.score1 += 1
                            else:
                                self.score2 += 1
                            break
                        
                        
                        if self.board.is_full():
                            self.board.disply()
                            print("روحو نامو اريح ملكوش باللعبه ،تعادل ياكبير")
                            break
                            
                       
                        self.switch_player()
                        
                    
            again = input("\nحابين تلعبو ؟؟ اكتبو نعم ")
            if again  != "نعم" :
                print("شكراً لأنكم لعبتوا معنا.. في أمان الله!")
                break      
